<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Secure storage (the Vault) is encrypted with a
     Keystore key that never leaves the device, so a restored copy could not
     be decrypted. Everything else is still backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
