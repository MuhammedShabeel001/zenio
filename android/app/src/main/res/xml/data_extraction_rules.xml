<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Secure storage (the Vault) is encrypted with a
     Keystore key that never leaves the device, so it is left out of cloud
     backups and device transfers. Everything else is still included. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
